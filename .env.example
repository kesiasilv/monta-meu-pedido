# Copie para .env e preencha. O .env nunca vai para o Git.

# Qual LLM usar: gemini ou claude
LLM_PROVIDER=gemini

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Confira o nome do modelo disponível no AI Studio
GEMINI_MODEL=gemini-3.8-flash

# Opcional, só se LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Classificador usado no workflow: baseline ou bertimbau
CLASSIFICADOR=baseline
# Seu modelo no Hugging Face (depois do fine-tuning)
HF_MODEL_ID=seu-usuario/bertimbau-tags-pratos

# Preço do LLM em USD por milhão de tokens, usado só para estimar custo na avaliação.
# Confira a tabela de preços atual do provedor.
LLM_PRECO_ENTRADA_USD_POR_MILHAO=0.30
LLM_PRECO_SAIDA_USD_POR_MILHAO=2.50
